# CK Quant Hedge —— docker compose 环境变量
# 复制成 .env 即可生效（.env 已被 .gitignore 挡住，不会进仓库）。
#
# 注意：这里的变量名是 CK_HEDGE_*。主项目的 CK_QUANT_* 名字**本仓库不读** ——
# 这样即使你的 .env 是从主项目复制来的，也不会静默把镜像指回 ck-quant。

CK_HEDGE_IMAGE=ericchenghz/ck-quant-hedge:latest
CK_HEDGE_CONTAINER_NAME=CK_Quant_Hedge

# 配置文件名（相对 ./user_data）。
# 注意：配置里必须有 "strategy" 字段，否则 freqtrade 会报 No strategy specified。
# 模板见 docs/examples/hedge-dryrun.example.json。
CK_HEDGE_CONFIG=config.json

# 历史数据目录（挂到容器内 /freqtrade/user_data/data/binance），回测用。
#
# ⚠️ 这一行要么**整行删掉**（用 compose 里的默认值 ./user_data/data/binance），
#    要么写一个**真实存在的目录** —— 千万不要留空：
#    compose 的 ${VAR:-默认} 会把"空值"当成"已设置"，挂载源变成空串，直接报错。
# 例：CK_HEDGE_DATA_DIR=D:/data/binance
#CK_HEDGE_DATA_DIR=

CK_HEDGE_DATABASE=tradesv3.sqlite
CK_HEDGE_LOGFILE=hedge.log

# 默认只绑本机：api_server 没有内置用户体系，不要直接暴露到公网
CK_HEDGE_WEBUI_BIND=127.0.0.1
CK_HEDGE_WEBUI_PORT=8080
